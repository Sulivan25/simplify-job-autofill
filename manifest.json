{
  "manifest_version": 3,
  "name": "Simplify Job Crawler",
  "version": "1.1",
  "description": "Tự động thu thập dữ liệu việc làm từ Simplify.",
  "permissions": ["scripting", "tabs", "downloads", "storage", "clipboardRead"],
  "action": {
    "default_title": "Simplify Job Crawler",
    "default_icon": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://*.Simplify.jobs/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.Simplify.jobs/jobs*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}